# Copy to .env and restrict permissions: chmod 600 .env
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cmms
DB_USER=cmms_app
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
CMMS_PORT=3001
CMMS_BIND=127.0.0.1
CMMS_SETUP_TOKEN=REPLACE_WITH_RANDOM_SETUP_TOKEN
CMMS_MEDIA_DIR=./media
CMMS_MAX_UPLOAD_MB=15
# Only set true when HTTPS is actually provided by a reverse proxy
CMMS_HTTPS=false